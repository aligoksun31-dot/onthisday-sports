---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Filters from "../components/Filters.astro";
import { presenting } from "../data/sponsors";
import SponsorBadge from "../components/SponsorBadge.astro";
import { allDates, eventsFor, MONTHS, cap, SITE } from "../data/dates";

const ny = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" }));
const todayKey = `${String(ny.getMonth() + 1).padStart(2, "0")}-${String(ny.getDate()).padStart(2, "0")}`;
const todayMeta = allDates.find((d) => d.key === todayKey)!;
const todayList = eventsFor(todayKey);
const sports = [...new Set(todayList.map((e) => e.sport))];
const pres = presenting();
const jsonld = { "@context": "https://schema.org", "@type": "WebSite", name: "On This Day in Sports", url: SITE };
---
<Base title="On This Day in Sports: Sports history for every date" description={`Discover what happened in sports on ${todayMeta.label} and every date in history: classic moments, wild facts and highlights.`} jsonld={jsonld}>
{pres && <p style="opacity:.8">Presented by <SponsorBadge s={pres}/></p>}
<h1>Today in sports history: {todayMeta.label}</h1>
<Filters sports={sports}/>
{todayList.length ? (
  <div class="cards">{todayList.map((e) => <Card e={e} label={todayMeta.label} slug={todayMeta.slug} />)}</div>
) : (
  <p>No moments added for today yet.</p>
)}
<p><a href={`/${todayMeta.slug}`}>See the full {todayMeta.label} page →</a></p>
<h2>Browse by month</h2>
{MONTHS.map((m, i) => (
  <section>
    <h3>{cap(m)}</h3>
    <div class="grid">
      {allDates.filter((d) => d.month === i + 1).map((d) => (
        <a class={eventsFor(d.key).length ? "has" : ""} href={`/${d.slug}`}>{d.day}</a>
      ))}
    </div>
  </section>
))}
</Base>
