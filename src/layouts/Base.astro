---
import { SITE } from "../data/dates";
const { title, description, jsonld } = Astro.props;
const url = new URL(Astro.url.pathname, SITE).href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={url}/><meta name="theme-color" content="#0b1020"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta property="og:type" content="website"/><meta property="og:site_name" content="On This Day in Sports"/><meta name="twitter:card" content="summary"/>
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary"/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>}
<style is:global>
:root{color-scheme:dark}*{box-sizing:border-box}
body{margin:0;font-family:system-ui,sans-serif;background:#0b1020;color:#e8ecf5;line-height:1.5}
a{color:#7cc4ff}main{max-width:1100px;margin:0 auto;padding:1rem}
.sponsor-bar{position:sticky;top:0;z-index:10;background:#ffcf5c;color:#111;text-align:center;padding:.4rem;font-size:.9rem}.sponsor-bar a{color:#111;font-weight:700}
header{background:#111a33;padding:.8rem 1rem;display:flex;gap:1rem;flex-wrap:wrap}header a{color:#fff;text-decoration:none}header .logo{font-weight:800;margin-right:auto}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin:1rem 0}
.ev{background:#151f3d;border-radius:14px;padding:1rem;display:flex;flex-direction:column;gap:.5rem;border:1px solid #22305a}
.yr{font-weight:800;font-size:1.3rem;color:#ffcf5c}.tag{background:#24335f;border-radius:99px;padding:.1rem .6rem;font-size:.8rem;margin-left:.5rem}
.ev p{margin:0;flex:1}.acts{display:flex;gap:.5rem;flex-wrap:wrap}.btn{display:inline-block;padding:.45rem .8rem;border-radius:8px;text-decoration:none;font-weight:600;font-size:.9rem;background:#e63946;color:#fff}.btn.x{background:#000;border:1px solid #444}
.filters{display:flex;flex-wrap:wrap;gap:.4rem}.filters button{background:#151f3d;color:#e8ecf5;border:1px solid #2c3b6a;padding:.35rem .8rem;border-radius:99px;cursor:pointer;font-size:.85rem}.filters button.on{background:#ffcf5c;color:#111}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(44px,1fr));gap:.3rem}.grid a{display:block;text-align:center;padding:.4rem 0;background:#151f3d;border-radius:6px;text-decoration:none}.grid a.has{background:#24447a}
.box{border:1px dashed #3a4c80;border-radius:12px;padding:1rem;margin:1.5rem 0}input,button.sub{padding:.6rem;border-radius:8px;border:0;font-size:1rem}button.sub{background:#ffcf5c;font-weight:700}
iframe{width:100%;aspect-ratio:16/9;border:0;border-radius:8px}footer{text-align:center;opacity:.6;padding:2rem}
</style></head><body>
<div class="sponsor-bar">Your logo here — <a href="/sponsor">sponsor this site</a></div>
<header><a class="logo" href="/">🏆 On This Day in Sports</a><a href="/facts">Facts</a><a href="/sponsor">Sponsor</a></header>
<main><slot/>
<section class="box" id="newsletter"><h2>📬 Get a daily sports flashback</h2>
<!-- Ready for Resend: create /api/subscribe (Vercel function) and set data-endpoint -->
<form class="nl" data-endpoint=""><input type="email" name="email" required placeholder="you@email.com" aria-label="Email"/> <button class="sub">Subscribe</button><p class="msg"></p></form></section>
</main><footer>On This Day in Sports · <a href="/facts">All facts</a> · <a href="/llms.txt">llms.txt</a> · <a href="/sponsor">Sponsor</a></footer>
<script>
document.querySelectorAll("form.nl").forEach(f=>f.addEventListener("submit",async e=>{e.preventDefault();const m=f.querySelector(".msg"),ep=f.dataset.endpoint,email=f.email.value;
if(!ep){m.textContent="Thanks! The newsletter launches soon.";return}
try{const r=await fetch(ep,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({email})});m.textContent=r.ok?"You're in!":"Something went wrong."}catch{m.textContent="Something went wrong."}}));
document.querySelectorAll(".filters").forEach(fl=>fl.addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;fl.querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));const s=b.dataset.sport;document.querySelectorAll(".ev").forEach(c=>c.style.display=(s==="all"||c.dataset.sport===s)?"":"none")}));
</script></body></html>
